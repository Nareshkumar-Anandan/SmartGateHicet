# SmartGate Environment Configuration Example
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smartgate_db
DB_CONNECTION_LIMIT=10

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=24h

# Institution Info
INSTITUTION_NAME=Hindusthan Institute of Technology
CAMPUS_LOCATION=Coimbatore, Tamil Nadu

# Hardware Integration Defaults
HARDWARE_SIMULATOR_ENABLED=true
TIMEWATCH_RELAY_PULSE_MS=3000
TIMEWATCH_CALLBACK_PORT=8080
